# Copy to .env (never commit .env)

# Qloo — hackathon key; base URL must be the hackathon host
QLOO_MODE=fixture            # fixture | live
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM (OpenAI-compatible). Any provider that speaks the OpenAI chat API works.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
# LLM_MODEL_STRONG=gpt-5

# Access control for live analysis (showcase cases are always public)
PASSCODE=
SESSION_SECRET=replace-with-a-long-random-string
CAP_LIVE_RUNS_PER_DAY=60
CAP_LIVE_RUNS_PER_SESSION=15

# Server
HOST=0.0.0.0
PORT=8000
SECURE_COOKIES=true           # false only for plain-http local dev
