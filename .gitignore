# Secrets: never commit
.env
.env.*
!.env.example
# Vite mode files: only VITE_MOCK=0/1, no secrets
!frontend*/.env.development
!frontend*/.env.api
*.pem
*.key

# Qloo response caches and recorded live data (Qloo forbids publishing response data)
**/data/cache/
*.sqlite
*.sqlite3
*.db
**/data/live/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / frontend
node_modules/
frontend/dist/
.vite/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Back-test outputs from fixture runs (live results under backend/eval/results/ ARE committed)
backend/eval/_fixture/

# Internal planning notes, not part of the submission (decide at the public flip)
TEA_ROSE_CONCEPT.md
backend/data/runs/

# Pre-computed showcase results contain Qloo response data: generated on the server, never committed
backend/data/showcase/*.json
!backend/data/showcase/manifest.json
